+    linear-gradient(148deg, rgba(255, 245, 157, 0.55) 0%, rgba(232, 245, 184, 0.28) 10%, rgba(255, 230, 0, 0.12) 22%, rgba(124, 179, 66, 0.05) 36%, transparent 48%),
