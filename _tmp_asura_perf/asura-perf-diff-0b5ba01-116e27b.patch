+}
+.page .inputPanel :global(.mega-friendly-form) input::placeholder { color: #a8a296 !important; font-weight: 400 !important; }
+.page .inputPanel :global(.mega-friendly-form) input:not([type="checkbox"]):not([type="radio"]):not([type="button"]):not([type="submit"]):focus,
