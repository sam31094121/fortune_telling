+.inputPanel [class*="text-green"], .inputPanel [class*="text-emerald"] { color: #b9d1bd; }
+.page .inputPanel :global(.mega-friendly-form) > section:has(:global(.form-missing-alert)) { border-color: #ce7b84; background: #2d1921; }
