+.inputPanel [class*="text-cyan"], .inputPanel [class*="text-violet"] { color: #e8d9a8; }
+.inputPanel :is([class*=" bg-cyan-"], [class^="bg-cyan-"], [class*=" bg-violet-"], [class^="bg-violet-"]) { background: #2a2110; box-shadow: none; }
