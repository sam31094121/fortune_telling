+/* Only the private Asura page uses this skin; shared forms retain their defaults. */
+.page {
+  --text-main: #f4efe4;
+  --text-sub: #c9c3b5;
+  --text-muted: #a8a296;
+  min-height: 100dvh;
+  padding: 24px max(16px, calc((100% - 1040px) / 2)) 80px;
+  background: #121210;
+  color: var(--text-main);
+  color-scheme: dark;
+}
+
+.nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
+.nav a, .nav button {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  color: #c9c3b5;
+  font-size: 13px;
+}
+.nav button { padding: 0 14px; border: 1px solid #aa7323; border-radius: 8px; }
+.nav a:hover, .nav button:hover { color: #fce74a; }
+.page button:disabled { opacity: .5; cursor: wait; }
+.page :is(a, button, summary):focus-visible { outline: 2px solid #fce74a; outline-offset: 4px; }
+
+.header { padding: 36px 0 30px; }
+.eyebrow { margin: 0; color: #aa7323; font-size: 12px; letter-spacing: .2em; }
+.header h1 { margin: 10px 0 16px; font-size: clamp(42px, 5vw, 64px); line-height: 1.3; }
+.intro { max-width: 650px; margin: 0; color: #c9c3b5; font-size: 15px; line-height: 1.85; }
+.panel {
+  min-width: 0;
+  margin-bottom: 28px;
+  padding: 24px;
+  border: 1px solid #aa7323;
+  border-radius: 16px;
+  background: #383836;
+  box-shadow: 0 12px 36px #0003;
+}
+.panel h2 { color: #fce74a; font-size: 22px; font-weight: 700; line-height: 1.5; }
+.note { margin: 0 0 20px; color: #c0baac; font-size: 13px; line-height: 1.8; }
+.fields { min-width: 0; border: 0; padding: 0; margin: 0; }
+.results { scroll-margin-top: 20px; outline: none; }
+.results:focus-visible { outline: 2px solid #fce74a; outline-offset: 5px; border-radius: 16px; }
+.error { margin: 20px 0 0; padding: 16px; border: 1px solid #be6971; border-radius: 12px; background: #381d24; color: #ffdae0; line-height: 1.8; }
+
+.login { display: grid; gap: 16px; max-width: 460px; }
+.login .note { margin: 0; }
+.login label, .zi { color: #efe9dc; font-size: 15px; font-weight: 600; }
+.login input, .zi select { width: 100%; min-height: 52px; padding: 12px; border: 1px solid #4a4842; border-radius: 8px; background: #121210; color: #f8f3e8; font-size: 16px; }
+.login > button { min-height: 52px; padding: 12px 20px; background: #aa7323; border: 1px solid #fce74a; border-radius: 10px; color: #121210; font-weight: 800; }
+.login a { color: #fce74a; text-decoration: underline; }
+.passwordField { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; }
+.passwordToggle { min-height: 48px; padding: 8px 12px; border: 1px solid #4a4842; border-radius: 8px; color: #e8d9a8; font-size: 13px; }
+.zi { display: grid; gap: 10px; margin-top: 16px; }
+
+/* Neutralize the site's cyan glow only inside this page's existing form. */
+.page .inputPanel :global(.mega-friendly-form) > section {
+  padding: 18px;
