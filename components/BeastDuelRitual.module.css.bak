.stage { position: fixed; inset: 0; height: 100dvh; z-index: 1000; overflow: hidden; padding: max(4px, env(safe-area-inset-top)) max(8px, env(safe-area-inset-right)) max(4px, env(safe-area-inset-bottom)) max(8px, env(safe-area-inset-left)); background: #090b18 center 64% / cover; color: #fff; }
.table { width: 100%; max-width: 640px; height: 100%; min-height: 0; margin: auto; display: grid; grid-template-rows: 44px minmax(0, 1fr); border: 1px solid #bba16655; border-radius: 18px; background: #080b18d9; box-shadow: 0 0 60px #81704525; overflow: hidden; }
.duelSplit { min-height: 0; display: grid; grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); }
.visualPane { min-height: 0; display: grid; grid-template-rows: 28px minmax(0, 1fr); padding: 0 8px 6px; overflow: hidden; }
.venueHeading { display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: #ffe4a4; }
.controlPane { min-height: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; border-top: 2px solid #7dd3fc; background: #101b2d; overflow: hidden; }
.handScroll { min-height: 0; overflow-y: auto; padding: 4px 10px; overscroll-behavior-y: contain; scrollbar-width: thin; }
.commands { padding: 4px 10px; border-top: 1px solid #4b5e78; }
.commands button { min-height: 48px; margin-top: 2px; touch-action: manipulation; }
.rules { margin-top: 6px; border-top: 1px solid #475569; font-size: 12px; line-height: 1.7; color: #c7d9ef; }
.rules summary, .rules a { display: block; min-height: 44px; align-content: center; cursor: pointer; }
.waitingCards { position: absolute; inset: 12% 9% 25%; z-index: 1; display: flex; gap: 20px; justify-content: center; align-items: center; pointer-events: none; }
.waitingCards > div { min-width: 0; height: 100%; width: 45%; display: grid; grid-template-rows: minmax(0, 1fr) 22px; text-align: center; font-size: 12px; }
.waitingCards img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 5px 10px #0009); }
.topline { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 0 10px; }
.topline h2 { font-size: 16px; color: #ffe4a4; font-weight: 800; }
.close { min-height: 44px; padding: 6px 10px; color: #bac1d0; font-size: 12px; }
.label { display: flex; justify-content: space-between; margin: 6px 0; font-size: 12px; color: #d9cfae; }
.label small { color: #939eaf; font-size: 11px; }
.row { width: min(100%, 224px); margin-inline: auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.slot { min-width: 0; perspective: 900px; }
.card { position: relative; width: 100%; transform-style: preserve-3d; transition: transform .72s ease-in-out; }
/* Clip each face, not the rotating container: hidden overflow flattens 3D. */
.slot > .card { overflow: visible; }
.card.revealed { transform: rotateY(180deg); }
.face { position: absolute; inset: 0; overflow: hidden; border-radius: 10px; border: 1px solid #d4b67688; backface-visibility: hidden; -webkit-backface-visibility: hidden; background: #13121d; }
.face img { width: 100%; height: 100%; object-fit: contain; object-position: center; }
.front { transform: rotateY(180deg); box-shadow: 0 0 18px #ead19735; }
.front small { position: absolute; top: 5px; right: 5px; padding: 2px 5px; background: #000c; border-radius: 8px; font-size: 10px; color: #fce9b8; }
.caption { margin-top: 4px; text-align: center; }
.caption strong { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; line-height: 16px; color: #e5dfcf; }
.dealing .card { animation: deal .65s both; }
.dealing .slot:nth-child(2) .card { animation-delay: .3s; }
.dealing .slot:nth-child(3) .card { animation-delay: .6s; }
.center { min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 4px; padding: 8px 4px; text-align: center; overflow: hidden; border-radius: 14px; }
.center > strong, .center > p { position: relative; z-index: 3; padding: 2px 8px; background: #060c16db; border-radius: 8px; pointer-events: none; }
.center strong { font-size: 16px; line-height: 24px; color: #ffdfa4; }
.center p { max-width: 350px; font-size: 11px; line-height: 18px; color: #b9c5d9; }
.clash strong { animation: glimmer .8s ease-out; }
.center.clash { background: radial-gradient(ellipse, #22365180, #070d1800 75%); }
.chargeVideo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; z-index: 2; border-radius: 16px; background: #080b18; pointer-events: none; }
.center.clash strong, .center.clash p { position: relative; z-index: 3; text-shadow: 0 2px 6px #000; pointer-events: none; }
/*
  交鋒時本體是亮的，字壓在上面仍然讀不出來（實測：標題整段被火兔蓋住）。
  疊層順序沒問題，問題是對比，所以給標題一層深色底而不是把它移開——
  移開會變成又一個浮動元素，那正是先前疊字的原因。
*/
.center.clash strong { padding: 1px 10px; border-radius: 999px; background: #060c16a8; }
.center.clash p { padding: 1px 8px; border-radius: 999px; background: #060c1685; }
.action { width: 100%; min-height: 48px; margin-top: 12px; border-radius: 14px; background: linear-gradient(100deg, #ffe8a1, #f0b86d); font-size: 15px; font-weight: 900; color: #302113; }
.action:disabled { background: #ffffff12; color: #a3a6b7; }
.skip { width: 100%; min-height: 48px; margin-top: 12px; color: #b6bfcc; font-size: 12px; }
@keyframes deal { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: none; } }
@keyframes glimmer { from { opacity: .4; transform: scale(.96); } to { opacity: 1; transform: none; } }
@media (max-height: 700px) {
  .row { width: min(100%, 150px); }
  .label { margin: 1px 0; font-size: 11px; line-height: 14px; }
  .caption { margin-top: 2px; }
  .caption strong { line-height: 14px; }
}
@media (orientation: landscape) and (max-height: 540px) {
  .table { max-width: 1100px; }
  .duelSplit { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); }
  .controlPane { border-top: 0; border-left: 2px solid #7dd3fc; }
}
@media (max-width: 350px) { .caption strong { font-size: 10px; } }
@media (prefers-reduced-motion: reduce) { .card { transition: none; } .dealing .card, .clash strong { animation: none; } }

/* 翻牌控制：手動一張一張翻，或切成自動。兩顆按鈕並排，手機一手可及。 */
.flipControls {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
  align-items: center;
}

/* The licensed ring backdrop is shared by the game entrance and combat stage. */
.arena {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  border-radius: 16px;
  pointer-events: none;
  /* 交鋒方的元素光色由 TSX 傳入；沒有就用中性色，不會開天窗。 */
  --arena-glow: #7dd3fc;
  opacity: 1;
  transition: opacity 260ms ease;
}
.clash .arena { opacity: 1; }

/* A mobile WebP and a dark top edge keep both the venue and the battle text visible. */
.arenaBackdrop {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 62%;
  opacity: .72;
  filter: saturate(.72) brightness(.8);
  /*
    頂端淡出。

    標題「前鋒・本體衝鋒」就壓在這一層的最上緣；實景一鋪上去，
    亮底把字洗掉了（加襯底之前是讀得清楚的，這是我自己造成的回退）。
    加深色晶片不夠——那只是補救對比。從根本讓實景在標題那條帶不存在，
    字就回到原本的深色底上，而神獸交戰的地面照樣看得見。
  */
  mask-image: linear-gradient(180deg, transparent 0, rgba(0, 0, 0, .3) 15%, #000 36%);
}

/* 地板：近端（玩家側）亮而實，遠端（對手側）暗而虛。 */
.arenaFloor {
  position: absolute;
  inset: 42% -12% -18% -12%;
  border-radius: 50%;
  background:
    radial-gradient(ellipse at 50% 100%, color-mix(in srgb, var(--arena-glow) 26%, transparent) 0%, transparent 62%),
    radial-gradient(ellipse at 50% 100%, #16233a 0%, #0a1120 55%, transparent 78%);
  box-shadow: inset 0 1px 0 color-mix(in srgb, var(--arena-glow) 38%, transparent);
  /*
    地平線那道弧原本是實邊，看起來像一個貼上去的橢圓，不像地面。
    往上淡出，弧頂就融進遠景霧氣裡——邊界要有，但不能看得出是邊界。
  */
  mask-image: linear-gradient(180deg, transparent, #000 22%);
}

/* 遠端的地平線霧氣：把對手側推遠，讓縱深看得出來。 */
.arenaHaze {
  position: absolute;
  inset: 0 0 55% 0;
  background: linear-gradient(#0a112000, color-mix(in srgb, var(--arena-glow) 10%, transparent));
}

/*
  兩側角柱。左右各一道立面光，讓「這是一個場地」而不是一塊背景。
  玩家角（下緣）比對手角亮一階——場子是玩家的。
*/
.arenaPost {
  position: absolute;
  top: 34%;
  bottom: 0;
  width: 14%;
  background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--arena-glow) 22%, transparent));
  mask-image: linear-gradient(180deg, transparent, #000 70%);
}
.arenaPost:first-of-type { left: 0; }
.arenaPost:last-of-type { right: 0; transform: scaleX(-1); }

/*
  能量環。用既有的撞擊圖，交鋒時緩慢轉，撞擊那一刻由三維層再閃一次。
  這裡刻意做得很淡——舞台是襯底，主角是神獸本體。
*/
.arenaRing {
  position: absolute;
  left: 50%;
  top: 74%;
  width: 96%;
  aspect-ratio: 1;
  transform: translate(-50%, -50%);
  background: url('/audio/taiji/lightning-impact-cc0.png') center / contain no-repeat;
  /*
    這張是閃電爆裂圖，不是圓環。第一版放大到 132% 又擺在中央，
    尖角散到舞台上半部，看起來像天空飄著碎片——是雜訊不是氣氛。
    壓小、下移到地板上、加模糊再降透明度，它就只剩「地面有東西在轉」的暗示。
  */
  filter: blur(6px);
  opacity: .06;
  mix-blend-mode: screen;
  animation: arenaSpin 18s linear infinite;
}
@keyframes arenaSpin { to { transform: translate(-50%, -50%) rotate(360deg); } }

@media (prefers-reduced-motion: reduce) {
  .arena { transition: none; }
  .arenaRing { animation: none; }
}
