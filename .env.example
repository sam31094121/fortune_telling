# 複製此檔為 .env.local 並填入你的金鑰
# 取得位置：https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Server-only Supabase credentials for the visitor counter.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# 這是假的

# 正式站網址（用於 sitemap、robots、OG canonical）
NEXT_PUBLIC_SITE_URL=https://heaven-earth-humanity-pair.vercel.app

# Google Search Console 網站驗證碼
# 取得位置：https://search.google.com/search-console → 新增資源 → HTML 標籤驗證，複製 content="..." 裡的值
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code_here

# Google Analytics 4 追蹤 ID
# 取得位置：https://analytics.google.com → 管理 → 資料串流 → 你的網站 → 評估 ID（格式 G-XXXXXXXXXX）
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ========== 雙人命盤客戶認證 ==========
DUAL_CHART_PASSWORD=your_client_password_here
DUAL_CHART_SESSION_SECRET=your_existing_session_secret_min_32_chars

# ========== 管理員後台認證 ==========
# 只有你能存取的隱藏後台，查看製作流程、來源授權、著作權信息
# 詳見 docs/ADMIN_SETUP.md

# 管理員密碼（設定為 630628）
ADMIN_MASTER_PASSWORD=630628

# Session 密鑰（至少 32 個字符，用 openssl rand -hex 32 生成）
ADMIN_SESSION_SECRET=generate_with_openssl_rand_hex_32_change_this_now

# 授權 IP 白名單（逗號分隔，無空格）
# 只有這些 IP 可以存取管理員後台
# 訪問 http://localhost:8888/api/admin/ip-check 查詢你的 IP
ADMIN_AUTHORIZED_IPS=YOUR_IP_ADDRESS_HERE
